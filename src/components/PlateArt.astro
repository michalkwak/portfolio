70.3 118.3Q178.7 115.3 186.4 115.3Q198 115.3 206.1 120.9Q214.3 126.4 219.3 135.6Q224.3 144.8 226.5 155.7Q228.8 166.6 228.8 177Q228.8 185.4 227.9 193.8Q227 202.2 225.2 209.9Q224.5 213.3 223.3 216.4Q227 218.5 229.9 220.5Q237.9 226.4 241.9 230.3Q245.8 233.9 247.9 237.6Q250.1 241.4 250.1 245Q250.1 248.2 248.4 250.4Q246.7 252.7 244 252.7Q241.7 252.9 239.7 250.8Q237.6 248.6 233.8 244.8Q230.8 241.6 225.8 236.4Q222.2 233 218.1 229.6Q215.2 234.8 211.6 239.3Q205.7 246.1 197.3 250.2Q188.9 254.3 177.5 254.3ZM206.3 221.7Q202.7 219.4 198.4 217.8Q189.8 214.4 179.6 214.4Q168.5 214.4 161.7 218.6Q154.9 222.8 154.9 229.4Q154.9 234.8 160 238.5Q165.1 242.3 174.6 242.3Q187.1 242.3 195.2 236.2Q201.8 231.2 206.3 221.7ZM82.5 210.5Q84.4 212.8 86.2 215.3Q90.5 221.2 94.3 226.3Q98.2 231.4 100.2 233.9Q101.8 235.5 102.5 235.3Q103.4 234.8 103.4 232.3Q103.6 225.5 103.3 215Q103 204.4 103 192Q103 186.1 103.2 180.2Q101.1 183.3 98.9 186.5Q93.2 195.1 87.3 204Q84.8 207.4 82.5 210.5Z';
---

<svg class="plate-art" viewBox="0 0 300 400" aria-hidden="true" data-jacobi={figure === 'jacobi' ? '' : undefined}>
  {
    figure === 'book' && (
      // The book from the Syllabuss logo, as a hairline. The tick draws itself on hover.
      <g class="book" transform="translate(52 92) scale(0.66)">
        <path d="M32 195 V40 Q32 12 60 10 L120 12 Q150 16 158 34 V212" />
        <path d="M158 34 Q168 12 195 10 L262 9 Q288 10 288 38 V186" />
        <path d="M32 195 Q34 210 60 210 L105 212 Q128 214 138 228" />
        <path d="M6 62 H44 M6 122 H44 M6 177 H44" />
        <path d="M186 70 L258 68 M186 107 L258 105 M186 145 L258 143" class="muted" />
        <path d="M68 112 L88 135 L132 83" class="plate-check" pathLength="100" />
      </g>
    )
  }
  {
    figure === 'jacobi' && (
      <g>
        {cells.map((cell) => (
          <rect
            class:list={['cell', { diag: cell.r === cell.c }]}
            x={cell.x}
            y={cell.y}
            width={CELL}
            height={CELL}
            rx="2"
            style={`fill-opacity: ${cell.o.toFixed(3)}`}
          />
        ))}
        <text class="plate-label jacobi-label" x="150" y={gridTop + N * (CELL + GAP) + 14} text-anchor="middle">
          {caption(FRAMES[0], false)}
        </text>
      </g>
    )
  }
  {
    figure === 'finland' && (
      <g>
        <path d={finland} />
        {towns.map((t) => {
          const [x, y] = project(t);
          return <circle class="dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r="2" />;
        })}
      </g>
    )
  }
  {
    figure === 'kana' && (
      <path d={ne} />
    )
  }
</svg>
