// One hairline drawing per plate, in a 300 × 400 box (the poster's 3:4). Strokes
// don't scale, so every line stays a hairline at any size.
import type { Figure } from '../data/projects';
import { FRAMES, N, caption, opacity } from '../scripts/figures/jacobi';

interface Props {
  figure: Figure;
}

const { figure } = Astro.props;

// Face recognition: the matrix the Jacobi solver diagonalises, as a grid of
// cells lit by their size. figures/jacobi.ts animates the sweeps on hover.
const CELL = 26;
const GAP = 4;
const gridLeft = (300 - (N * CELL + (N - 1) * GAP)) / 2;
const gridTop = 92;
const cells = FRAMES[0].a.flatMap((row, r) =>
  row.map((_, c) => ({ r, c, x: gridLeft + c * (CELL + GAP), y: gridTop + r * (CELL + GAP), o: opacity(FRAMES[0], r, c) })),
);

// Resilience: Finland's outline in (lon, lat), clockwise from the south-west coast,
// and a few towns. Projected with longitudes shrunk by cos(64°).
const outline: [number, number][] = [
  [22.3, 60.1], [22.9, 59.85], [23.5, 59.95], [25.0, 60.2], [26.5, 60.4], [27.8, 60.55],
  [28.6, 60.8], [29.7, 61.3], [30.9, 62.0], [31.5, 62.9], [30.6, 63.5], [30.0, 63.9],
  [30.5, 64.3], [29.6, 64.9], [29.9, 65.6], [29.5, 66.1], [29.9, 66.8], [29.1, 67.6],
  [29.7, 67.9], [28.6, 68.3], [28.5, 68.9], [28.9, 69.05], [29.3, 69.3], [28.9, 69.7],
  [28.4, 70.0], [27.9, 70.08], [27.0, 69.9], [26.0, 69.65], [25.8, 69.35], [25.2, 69.0],
  [24.9, 68.6], [24.0, 68.75], [23.2, 68.65], [22.4, 68.7], [21.6, 69.2], [21.27, 69.31],
  [20.55, 69.06], [21.3, 68.75], [22.5, 68.44], [23.7, 67.95], [23.6, 67.3], [23.97, 66.78],
  [23.7, 66.2], [24.15, 65.85], [25.0, 65.6], [25.45, 65.0], [24.6, 64.6], [23.8, 64.1],
  [22.5, 63.5], [21.5, 63.2], [21.2, 62.6], [21.4, 62.0], [21.5, 61.5], [21.4, 60.9],
  [21.9, 60.5],
];
const towns: [number, number][] = [
  [24.94, 60.17], [22.27, 60.45], [23.76, 61.5], [25.66, 60.98], [21.8, 61.48], [25.73, 62.24],
  [27.68, 62.89], [29.76, 62.6], [21.62, 63.1], [22.84, 62.79], [25.47, 65.01], [27.73, 64.23],
  [24.56, 65.74], [25.72, 66.5], [26.94, 60.47],
];
const project = ([lon, lat]: [number, number]) => [150 + (lon - 25.8) * 0.44 * 19.4, 166 - (lat - 65) * 19.4];
const finland = 'M' + outline.map((p) => project(p).map((n) => n.toFixed(1)).join(' ')).join(' L') + ' Z';

// Kana Quest: ね, the quiz question, outlined. The outline is taken from
// Noto Serif JP (SIL Open Font License), so it looks the same on every device.
