---
import Callouts from './Callouts.astro';
import Gojuon from './posters/Gojuon.astro';
import MetroMap from './posters/MetroMap.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const word = p.word ?? '';
const upright = /[぀-ヿ一-龯]/.test(word);
// Fallback size for the vertical word; posters.ts fits it exactly once fonts load.
const wordSize = upright ? 30 : Math.min(30, 118 / Math.max(1, [...word].length * 0.56));
const style = [
  `--bg: ${p.colors.bg}`,
  `--ink: ${p.colors.ink}`,
  `--art: ${p.colors.art ?? p.colors.ink}`,
  p.colors.xrayBg && `--xray-bg: ${p.colors.xrayBg}`,
  p.colors.xrayFg && `--xray-fg: ${p.colors.xrayFg}`,
  `--word-size: ${wordSize.toFixed(2)}cqi`,
]
  .filter(Boolean)
  .join('; ');
---

<article class:list={['poster', { featured: p.featured }]} style={style} data-lens data-id={p.id} data-live={p.live}>
  {
    p.live ? (
      <canvas class="poster-art" aria-hidden="true" />
    ) : (
      <canvas
        class="poster-art"
        data-pattern={p.pattern}
        data-ink={p.colors.art ?? p.colors.ink}
        data-layer={p.layer}
        data-layer-ink={p.layer && p.colors.ink}
        aria-hidden="true"
      />
    )
  }

  <div class="poster-face">
    <div class="poster-top">
      <span>{p.index} / {p.kind}</span>
      <span>{p.year}</span>
    </div>
    {word && <span class:list={['poster-word', { upright }]} aria-hidden="true">{word}</span>}
    {p.rule && <Callouts callouts={[]} rule={p.rule} />}
    {p.overlay === 'gojuon' && <Gojuon mode="kana" />}
    <div class="poster-bottom">
      <h3>{p.title}</h3>
      {p.finding && <p class="poster-finding">{p.finding}</p>}
      <p>{p.blurb}</p>
      <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
    </div>
  </div>

  {
    p.live ? (
      <div class="xray" aria-hidden="true">
        <canvas class="xray-canvas" />
      </div>
    ) : p.overlay === 'metro' ? (
      <div class="xray xray-key xray-metro" aria-hidden="true">
        <p class="xray-label">Your degree as a route map — {p.index}</p>
        <MetroMap />
      </div>
    ) : p.overlay === 'gojuon' ? (
      <div class="xray xray-key" aria-hidden="true">
        <p class="xray-label">Answer key — {p.index}</p>
        <Gojuon mode="romaji" />
      </div>
    ) : (
      <div class="xray" aria-hidden="true">
        <p class="xray-label">Structure — {p.index}</p>
        <ol class="xray-steps">{p.structure.map((step) => <li>{step}</li>)}</ol>
      </div>
    )
  }
  <span class="lens-ring" aria-hidden="true"></span>
  <!-- Covers the poster; opens it in the project view (src/scripts/projectView.ts). -->
  <button class="poster-hit" type="button" aria-label={`Open ${p.title}`} aria-haspopup="dialog"></button>
</article>
