---
// A degree drawn as a metro map: each study track is a line, courses are
// stations, shared courses are interchanges, and every line runs to the thesis.
// Coordinates are in a 300 × 400 box (the poster's 3:4), clear of its header,
// vertical word and caption. Labels are knocked out of the lines behind them.

type Line = 'core' | 'data' | 'math' | 'web';
type Anchor = 'start' | 'middle' | 'end';

const lines: Record<Line, string> = {
  core: 'M70 70 H205 L240 105 V230',
  data: 'M70 115 H275 V195 L240 230',
  web: 'M70 175 H240',
  math: 'M70 230 H240',
};

const stations: { name: string; x: number; y: number; label: [number, number, Anchor]; kind?: 'interchange' | 'terminus' }[] = [
  { name: 'Prog. I', x: 70, y: 70, label: [66, 61, 'start'] },
  { name: 'Prog. II', x: 125, y: 70, label: [125, 61, 'middle'] },
  { name: 'DSA I', x: 170, y: 70, label: [170, 61, 'middle'] },
  { name: 'DSA II', x: 205, y: 70, label: [205, 61, 'middle'] },
  { name: 'Stats & R I', x: 70, y: 115, label: [66, 127, 'start'] },
  { name: 'Data Analysis', x: 150, y: 115, label: [150, 127, 'middle'] },
  { name: 'Intro to AI', x: 208, y: 115, label: [208, 127, 'middle'] },
  { name: 'Databases', x: 240, y: 115, label: [246, 107, 'start'], kind: 'interchange' },
  { name: 'Full Stack', x: 70, y: 175, label: [66, 187, 'start'] },
  { name: 'Software Eng.', x: 240, y: 175, label: [234, 167, 'end'], kind: 'interchange' },
  { name: 'Lin. Algebra', x: 70, y: 230, label: [66, 221, 'start'] },
  { name: 'Probability', x: 148, y: 230, label: [148, 221, 'middle'] },
  { name: 'Stats & R II', x: 202, y: 230, label: [202, 221, 'middle'] },
  { name: 'Thesis · 180 cr', x: 240, y: 230, label: [240, 249, 'middle'], kind: 'terminus' },
];

const radius = { interchange: 5.5, terminus: 7.5 };
---

<svg class="metro" viewBox="0 0 300 400" aria-hidden="true">
  {Object.entries(lines).map(([line, d]) => <path class={`metro-line ${line}`} d={d} />)}
  {
    stations.map((s) => (
      <circle class:list={['metro-stop', s.kind]} cx={s.x} cy={s.y} r={s.kind ? radius[s.kind] : 3} />
    ))
  }
  <circle class="metro-hub" cx="240" cy="230" r="3" />
  {
    stations.map((s) => (
      <text x={s.label[0]} y={s.label[1]} text-anchor={s.label[2]} class:list={['metro-label', { major: s.kind === 'terminus' }]}>
        {s.name}
      </text>
    ))
  }
</svg>
